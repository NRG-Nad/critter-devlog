---
import { SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Current path with the base prefix stripped, for active-link highlighting.
const path = Astro.url.pathname.replace(base, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const links = [
  { href: '/devlog', label: 'Devlog' },
  { href: '/tutorials', label: 'Tutorials' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/about', label: 'About' },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href={`${base}/`}>
      <span class="mark"></span>{SITE_TITLE}
    </a>
    <nav class="site-nav">
      {links.map((l) => (
        <a href={`${base}${l.href}`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>