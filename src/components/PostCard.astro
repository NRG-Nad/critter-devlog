---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { SECTIONS, type SectionKey } from '../consts';
import { categoryMeta } from '../data/categories';

interface Props {
  href: string;
  section: SectionKey;
  title: string;
  description: string;
  pubDate: Date;
  cover?: any;
  coverAlt?: string;
  tags?: string[];
  difficulty?: string;
  /** Devlog category id — shown as a colored badge instead of the section badge. */
  category?: string;
  feature?: boolean;
  milestone?: boolean;
}

const {
  href, section, title, description, pubDate,
  cover, coverAlt, tags = [], difficulty, category,
  feature = false, milestone = false,
} = Astro.props;

const meta = SECTIONS[section];
const cat = category ? categoryMeta(category) : null;
const initial = title.trim().charAt(0).toUpperCase();
const classes = ['card', (feature || milestone) && 'card-feature', milestone && 'card--milestone']
  .filter(Boolean)
  .join(' ');
---
<a class={classes} href={href} data-accent={meta.accent}>
  {cover ? (
    <Image class="card-cover" src={cover} alt={coverAlt ?? title} width={800} height={450} />
  ) : (
    <div class="card-cover placeholder" aria-hidden="true"><span class="ph-mark">{initial}</span></div>
  )}
  <div class="card-body">
    <div class="card-meta">
      {cat ? (
        <span class="badge badge--cat" style={`--cat-color:${cat.color}`}>{cat.glyph} {cat.label}</span>
      ) : (
        <span class="badge">{meta.label}</span>
      )}
      <FormattedDate date={pubDate} />
      {difficulty && <span class={`diff ${difficulty}`}>{difficulty}</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <span class="card-spacer"></span>
    {tags.length > 0 && (
      <div class="post-tags">
        {tags.slice(0, 3).map((t) => <span class="tag-pill">{t}</span>)}
      </div>
    )}
  </div>
</a>