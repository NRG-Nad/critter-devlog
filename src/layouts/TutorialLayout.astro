---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import { SECTIONS } from '../consts';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  cover?: any;
  coverAlt?: string;
  tags?: string[];
  difficulty: string;
  engineVersion?: string;
  series?: string;
  prerequisites?: string[];
}

const {
  slug, title, description, pubDate, updatedDate, cover, coverAlt,
  tags = [], difficulty, engineVersion, series, prerequisites = [],
} = Astro.props;

const meta = SECTIONS.tutorials;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build series navigation if this tutorial belongs to one.
let seriesParts: { slug: string; title: string }[] = [];
if (series) {
  const all = await getCollection('tutorials', ({ data }) => !data.draft && data.series === series);
  seriesParts = all
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
    .map((p) => ({ slug: p.slug, title: p.data.title }));
}
---
<BaseLayout title={title} description={description} accent={meta.accent}>
  <article>
    {cover && <Image class="post-cover" src={cover} alt={coverAlt ?? title} width={1200} height={675} />}
    <header class="post-header">
      <div class="post-meta">
        <span class="badge">{meta.label}</span>
        <span class={`diff ${difficulty}`}>{difficulty}</span>
        {engineVersion && <span>· {engineVersion}</span>}
        <FormattedDate date={pubDate} />
        {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-description">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">{tags.map((t) => <span class="tag-pill">{t}</span>)}</div>
      )}
    </header>

    {(prerequisites.length > 0 || series) && (
      <div class="callout">
        {series && <h4>Part of the series: {series}</h4>}
        {prerequisites.length > 0 && (
          <>
            <h4>Prerequisites</h4>
            <ul>{prerequisites.map((p) => <li>{p}</li>)}</ul>
          </>
        )}
      </div>
    )}

    <slot />

    {seriesParts.length > 1 && (
      <nav class="series-nav">
        <div class="series-nav-title">{series} — full series</div>
        <ol>
          {seriesParts.map((p) => (
            <li class={p.slug === slug ? 'current' : ''}>
              {p.slug === slug ? p.title : <a href={`${base}/tutorials/${p.slug}/`}>{p.title}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <nav class="post-nav">
      <a href={`${base}${meta.href}`}>&larr; All tutorials</a>
    </nav>
    <Comments />
  </article>
</BaseLayout>