---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SECTIONS } from '../../consts';
import { CATEGORIES, CATEGORY_IDS, isMilestone } from '../../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('devlog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Only show filter chips for categories that actually have posts, in taxonomy order.
const present = CATEGORY_IDS.filter((id) => posts.some((p) => p.data.category === id));
---
<BaseLayout title="Devlog" variant="wide" accent="rift">
  <h1>Devlog</h1>
  <p class="tagline">{SECTIONS.devlog.blurb}</p>

  {posts.length === 0 ? (
    <p class="lead">No posts yet — the first monthly update lands soon.</p>
  ) : (
    <>
      {present.length > 1 && (
        <div class="filterbar" id="cat-filter">
          <button data-cat="" aria-pressed="true">All</button>
          {present.map((id) => (
            <button data-cat={id} title={CATEGORIES[id].blurb} style={`--cat-color:${CATEGORIES[id].color}`}>
              {CATEGORIES[id].glyph} {CATEGORIES[id].label}
            </button>
          ))}
        </div>
      )}

      <div class="card-grid">
        {posts.map((post) => {
          const mile = isMilestone(post.data.category);
          return (
            <div class={`card-wrap${mile ? ' card-wrap--feature' : ''}`} data-category={post.data.category}>
              <PostCard
                href={`${base}/devlog/${post.slug}/`}
                section="devlog"
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                cover={post.data.cover}
                coverAlt={post.data.coverAlt}
                tags={post.data.tags}
                category={post.data.category}
                milestone={mile}
              />
            </div>
          );
        })}
      </div>
    </>
  )}
</BaseLayout>

<script>
  // Client-side category filter — toggles .card-wrap visibility by data-category.
  const bar = document.getElementById('cat-filter');
  if (bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const wraps = [...document.querySelectorAll<HTMLElement>('.card-wrap')];
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const cat = btn.dataset.cat ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      wraps.forEach((w) => {
        w.style.display = !cat || w.dataset.category === cat ? '' : 'none';
      });
    });
  }
</script>