---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RoadmapCanvas from '../components/RoadmapCanvas.tsx';
import type { BoardColumn } from '../data/roadmap-board';

// Columns come from the Tina-managed `roadmap` collection, ordered left → right.
const board: BoardColumn[] = (await getCollection('roadmap'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    label: entry.data.label,
    kind: entry.data.kind,
    features: entry.data.features,
  })) as BoardColumn[];
---
<BaseLayout title="Roadmap" variant="flush" accent="biome">
  <div class="rmc-intro">
    <h1>Roadmap</h1>
    <p>
      The whole plan as one board — drag to pan, scroll to zoom. Columns are areas of the
      game (systems on the left, biomes on the right); each feature's mechanics are tagged
      by priority, from P0 (must-have) to TBD (icebox).
    </p>
  </div>
  <div class="rmc-stage">
    <RoadmapCanvas board={board} client:only="react" />
  </div>
</BaseLayout>

<style>
  .rmc-intro {
    max-width: var(--maxw-wide);
    margin: 0 auto;
    padding: 2.2rem 1.25rem 1rem;
  }
  .rmc-intro h1 { margin: 0 0 0.4rem; }
  .rmc-intro p { color: var(--text-dim); margin: 0; max-width: 70ch; }
  .rmc-stage {
    height: calc(100dvh - 200px);
    min-height: 560px;
    margin: 0.5rem 1.25rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background:
      radial-gradient(900px 500px at 30% -20%, rgba(63,217,179,0.05), transparent 60%),
      var(--bg-2);
  }
</style>